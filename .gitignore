# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── 构建产物（可随时重建）────────────────────────────────
build/
dist/
*.spec.bak

# ── 运行期数据（含真实业务数据，绝不入库）──────────────────
data/
logs/
!data/.gitkeep

# ── 历史归档（如需留档可单独提交，默认不入库）─────────────
archive/

# ── 临时文件 ────────────────────────────────────────────
*.tmp
*.log
~$*
Thumbs.db
desktop.ini

# ── 真实业务样本（含客户名称 / 订单台账 / 图纸，绝不入库）──
/*.xlsx
/*.xls
/*.docx
/*.doc
/*.pdf
/*.dwg
/*.dxf
/*.png
/*.jpg
/*.jpeg
docs/迁移报告_销售订单.md

# ── 本机运行痕迹 / 更新过程目录 ────────────────────────────
.workbuddy/
_update_*/
_old_*/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.pyc
*.pyo

# ── 发布凭据（绝不入库）──────────────────────────────────
.env
.env.*
*.token
github_token.txt
